/* Shared GUI vocabulary (§6.3): imported by the built-in feature scripts so
 * pagination controls and common action labels stay worded consistently
 * across every form. Definitions only — imported files must not carry
 * executable statements; the form type names below are constants, not logic. */

const FORM_CUSTOM = 1;
const FORM_MESSAGE = 2;
const FORM_PAGINATED = 3;
const FORM_SCRIPT = 4;

component PageControls() {
    previousButton(pagePrevious());
    nextButton(pageNext());
    chooseButton(pageChoose(), pageChooseInput());
}

component SectionHeader() {
    spacer(new SpacingOptions());
    divider(new DividerOptions());
}

component ConfirmBar(confirmText, onConfirm) {
    button(confirmText, on: onConfirm, new ButtonOptions());
    closeButton();
}

func dropdownItem(label: string, value: int) -> DropdownItem {
    let item = new DropdownItem();
    item.label = label;
    item.value = value;

    return item;
}

func tooltipOption(tooltip: string) -> ButtonOptions {
    let option = new ButtonOptions();
    option.tooltip = tooltip;

    return option;
}

func pagePrevious() -> string {
    return {tr("generic.gui.page.previous")};
}

func pageNext() -> string {
    return {tr("generic.gui.page.next")};
}

func pageChoose() -> string {
    return {tr("generic.gui.page.choose")};
}

func pageChooseInput() -> string {
    return {tr("generic.gui.page.choose.input")};
}

func saveLabel() -> string {
    return {tr("generic.gui.save")};
}

func cancelLabel() -> string {
    return {tr("generic.gui.cancel")};
}
